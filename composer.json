{
  "name": "ajaflow/sdk",
  "description": "PHP client for the AJA order API: the shop sends its orders and polls the merchant's actions.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "Aja\\": "src/"
    }
  },
  "config": {
    "sort-packages": true
  },
  "scripts": {
    "conformance": "php conformance/run.php"
  },
  "archive": {
    "exclude": [
      "/conformance"
    ]
  }
}
