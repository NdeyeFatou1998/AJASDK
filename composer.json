{
  "name": "aja/sdk",
  "description": "PHP client for the AJA order API. The shop calls AJA; AJA never calls the shop.",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": "^8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "Aja\\": "src/"
    }
  },
  "config": {
    "sort-packages": true
  },
  "scripts": {
    "conformance": "php conformance/run.php"
  },
  "archive": {
    "exclude": [
      "/conformance"
    ]
  }
}
